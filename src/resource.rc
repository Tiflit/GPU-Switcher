#include <winres.h>
#include "resource.h"

IDI_APP_ICON     ICON "icons/ico/main-rainbow.ico"

IDI_ICON_INTEL   ICON "icons/ico/intel-blue.ico"
IDI_ICON_NVIDIA  ICON "icons/ico/nvidia-green.ico"
IDI_ICON_AMD     ICON "icons/ico/amd-red.ico"
IDI_ICON_UNKNOWN ICON "icons/ico/unknown-grey.ico"
IDI_ICON_WARNING ICON "icons/ico/warning-yellow.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Tiflit"
            VALUE "FileDescription",  "GPU-Switcher - Discrete GPU Activator"
            VALUE "FileVersion",      "1.1.0.0"
            VALUE "InternalName",     "GPU-Switcher"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "GPU-Switcher.exe"
            VALUE "ProductName",      "GPU-Switcher"
            VALUE "ProductVersion",   "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
